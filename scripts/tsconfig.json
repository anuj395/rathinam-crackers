{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "..",
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "allowImportingTsExtensions": true,
    "baseUrl": "..",
    "paths": {
      "@workspace/db": ["lib/db/src/index"],
      "@workspace/*": ["*"]
    }
  },
  "include": ["src", "../lib"],
  "exclude": ["src/seed.ts", "../node_modules", "../dist"]
}
